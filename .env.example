# ============================================================
# AI Insight Agent 环境配置（复制为 .env 后填写）
# cp .env.example .env
# ============================================================

# ---------- LLM（OpenAI 兼容 API，可选） ----------
# 配置后走真实 LLM；不配置则自动降级为内置规则引擎（离线可跑通全流程）
# 兼容 DeepSeek / OpenAI / Moonshot / 通义 等任何 OpenAI 协议端点
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 评分类调用温度 0.1；内容生成类 0.3；真实性判断类 0.1（规格 Sheet00 R12）
LLM_TEMP_SCORE=0.1
LLM_TEMP_GENERATE=0.3

# ---------- 调度 ----------
# 每日自动触发时间（cron 风格 HH:MM，24 小时制）
SCHEDULE_TIME=08:00
# 全局硬超时（分钟），规格 Sheet00 R7：默认 30 分钟
GLOBAL_TIMEOUT_MIN=30
# 各采集模块超时（分钟），规格 Sheet00 R13：默认 20 分钟
MODULE_TIMEOUT_MIN=20

# ---------- 采集窗口 ----------
# 默认采集过去 N 小时；无结果时自动扩展 48/72 小时（规格 Sheet00 R9）
TIME_WINDOW_HOURS=24
# 每模块默认 TopN（规格 Sheet00 R10）
TOP_N=5

# ---------- 数据目录 ----------
# SQLite 数据库路径（相对于项目根目录）
DB_PATH=data/ai_insight.db
# 日报输出目录
REPORT_DIR=reports
# 日志目录
LOG_DIR=logs

# ---------- 推送（邮件，可选） ----------
# 默认关闭（MAIL_ENABLED=false），clone 后不会误发。
# 开启后日报生成完毕会自动推送到 MAIL_TO（本地 SMTP / 云端 GitHub Secrets 二选一）。
# 本地配置示例（QQ 邮箱）：
#   MAIL_ENABLED=true
#   MAIL_SMTP_HOST=smtp.qq.com
#   MAIL_SMTP_PORT=465
#   MAIL_USER=your@qq.com        # 发件邮箱
#   MAIL_PASS=your-auth-code     # QQ 邮箱授权码（非登录密码，需在邮箱设置中生成）
#   MAIL_TO=your@qq.com          # 收件邮箱（可多个，逗号分隔）
# 测试：npm run mail:test
MAIL_ENABLED=false
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_TO=
